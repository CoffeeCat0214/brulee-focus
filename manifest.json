{
  "manifest_version": 3,
  "name": "CoffeeCat",
  "version": "1.0.0",
  "description": "A tiny coffee cat that keeps you company and pours you a focus timer you can see.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "CoffeeCat",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "permissions": ["storage", "alarms"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["src/content.css"],
      "js": ["src/settings.js", "src/mug-geometry.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/coffeecat-buddy.png",
        "assets/mug/mug-back.png",
        "assets/mug/mug-fill.png",
        "assets/mug/mug-front.png",
        "assets/mug/mug-steam.png",
        "src/shared.css",
        "src/float.css",
        "src/intermission.css"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
